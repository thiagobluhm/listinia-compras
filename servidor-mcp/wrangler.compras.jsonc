/**
 * Listinia — Worker de COMPRAS (plugin listinia-compras)
 * Despensa do consumidor + consulta de ofertas. 10 ferramentas.
 *
 * Deploy: npm run deploy:compras
 * Divide D1 e OAUTH_KV com o Worker de Mercado — mesmo banco, mesma sessao.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "listinia-compras",
	"main": "src/compras.ts",
	"compatibility_date": "2026-07-02",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },

	// A zona listinia.com.br ja esta na Cloudflare. O custom_domain cria o
	// registro DNS sozinho no primeiro deploy.
	"routes": [
		{ "pattern": "compras-mcp.listinia.com.br", "custom_domain": true }
	],

	"vars": {
		// Conta Google que recebe a despensa legada no primeiro login.
		"EMAIL_DONO_LEGADO": "thiagobluhm@gmail.com",
		// Precisa bater EXATAMENTE com a URL digitada na Claude, /mcp incluido.
		"MCP_RESOURCE": "https://compras-mcp.listinia.com.br/mcp"
		// workers.dev (anterior): "https://listinia-compras.thiagobluhm.workers.dev/mcp"
	},
	"kv_namespaces": [
		{ "binding": "OAUTH_KV", "id": "ad6da5681bd64333b4af51b0f1758ad1" }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "listinia",
			"database_id": "352349d4-ff27-4322-b605-14a9a32ed842"
		}
	]
}
