/**
 * Listinia — Worker do WHATSAPP (harness próprio, canal Z-API)
 * Terceiro perfil. Não é servidor MCP: não tem /mcp, não sobe OAuth.
 * As mesmas ferramentas de compras, chamadas em memória, sobre o mesmo D1.
 *
 * Deploy: npm run deploy:zap
 *
 * Segredos (NUNCA no jsonc — `wrangler secret put -c wrangler.zap.jsonc`):
 *   ZAPI_INSTANCIA, ZAPI_TOKEN, ZAPI_CLIENT_TOKEN, ZAPI_WEBHOOK_SEGREDO, FOUNDRY_API_KEY
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "listinia-zap",
	"main": "src/zap.ts",
	"compatibility_date": "2026-07-02",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },

	// O Foundry serve Claude e GPT no mesmo recurso. O modelo fica aqui, e não
	// no código, para que trocar opus-5 por sonnet-5 ou haiku-4-5 seja uma
	// linha e um deploy de config — sem tocar no harness.
	"vars": {
		"FOUNDRY_RESOURCE": "fdrybluhm",
		"FOUNDRY_MODELO": "claude-haiku-4-5",
		"FOUNDRY_MODELO_VISAO": "claude-opus-5",
		"FOUNDRY_WORKER_A": "claude-haiku-4-5",
		"FOUNDRY_WORKER_B": "claude-sonnet-5",
		// Teto DESLIGADO na janela de teste do WhatsApp (13/09/2026), por ordem do
		// dono: com 30 nao cabia uma rodada de teste inteira. A CONTAGEM continua —
		// `uso_diario` soma sempre, e o teto so decide se responde — entao o turno
		// medio por nota sai da medida e este numero volta calibrado depois.
		// Cuidado: "0" NAO desliga. O codigo le `Number(...) || 30`, e zero e falsy,
		// entao "0" REATIVA o teto de 30. Desligar e por um numero alto.
		"LIMITE_TURNOS_DIA": "100000",
		// Narração do andamento em turno com foto. "0" cala o narrador sem deploy.
		"NARRADOR": "1"
	},

	// Sem custom_domain enquanto for MVP de um número só: a URL workers.dev
	// serve para apontar o webhook da Z-API. O domínio entra quando o produto
	// sair do teste com uma pessoa.

	// Browser Run (ex-Browser Rendering): Chrome headless para abrir a pagina da
	// NFC-e na Receita. As SEFAZ montam a tabela de itens por JavaScript, entao
	// um `fetch` traz HTML vazio e a nota parece nao ter item nenhum.
	"browser": { "binding": "NAVEGADOR" },

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "listinia",
			"database_id": "352349d4-ff27-4322-b605-14a9a32ed842"
		}
	],

	// O TURNO NAO CABE NO WEBHOOK, e nao cabia no `waitUntil` tambem.
	//
	// Medido em 12/09/2026 com nota real: baixar a foto custa 0,3 s e os dois
	// leitores da loja 3,7 s, mas o turno do modelo de visao — ler 22 itens e
	// gravar item a item — passa MINUTOS. A Cloudflare cancela o `waitUntil`
	// muito antes disso, e a pessoa nao recebia resposta nenhuma. Cortar etapa
	// nao resolveria: as etapas baratas somam 4 s de um problema de minutos.
	//
	// Entao o webhook so ENFILEIRA e responde na hora (a Z-API reentrega se
	// demorarmos), e o consumidor processa com o tempo de sobra que a fila da.
	// Um por vez em cada invocacao, para uma nota lenta nao segurar a fila de
	// outra pessoa.
	"queues": {
		"producers": [{ "queue": "listinia-zap-turnos", "binding": "FILA" }],
		"consumers": [
			{
				"queue": "listinia-zap-turnos",
				"max_batch_size": 1,
				"max_concurrency": 5,
				// O `catch` do handler ja responde a pessoa e nao relanca, entao
				// retry aqui so pegaria falha de infraestrutura.
				"max_retries": 2
			}
		]
	}
}
