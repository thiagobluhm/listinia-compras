/**
 * Listinia — servidor MCP da despensa
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "listinia-despensa",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-02",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	// Preencha com a conta Google que você vai usar para entrar. É o que
	// devolve a despensa atual (u_legado) para você no primeiro login,
	// em vez de criar uma despensa nova e vazia. Vazio = sem vínculo.
	"vars": {
		"EMAIL_DONO_LEGADO": "thiagobluhm@gmail.com",
		"MCP_RESOURCE": "https://listinia-despensa.thiagobluhm.workers.dev/mcp"
	},
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "ad6da5681bd64333b4af51b0f1758ad1"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "listinia",
			"database_id": "352349d4-ff27-4322-b605-14a9a32ed842"
		}
	]
}
